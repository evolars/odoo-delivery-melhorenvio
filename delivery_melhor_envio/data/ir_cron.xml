<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Token do Melhor Envio vencendo: e-mail aos administradores 15, 7, 3 e 1 dia antes
         e no dia. Sem token válido a cotação falha e o método some do checkout. -->
    <record id="ir_cron_melhor_envio_token_reminder" model="ir.cron">
        <field name="name">Melhor Envio: avisar token vencendo</field>
        <field name="model_id" ref="delivery.model_delivery_carrier"/>
        <field name="state">code</field>
        <field name="code">model._cron_melhor_envio_token_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Etiquetas a caminho: o status é consultado a cada 3 horas, até a entrega. -->
    <record id="ir_cron_melhor_envio_refresh_tracking" model="ir.cron">
        <field name="name">Melhor Envio: atualizar rastreio</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_melhor_envio_refresh_tracking()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
